-- Логика Хитбокса
local hitboxActive = false
local hitboxConnection = nil
local originalPartSizes = {}

HitboxToggle.MouseButton1Click:Connect(function()
    hitboxActive = not hitboxActive
    
    local newColor
    if hitboxActive then
        HitboxToggle.Text = "Glove Hitbox: ON"
        newColor = Color3.fromRGB(45, 180, 45)
    else
        HitboxToggle.Text = "Glove Hitbox: OFF"
        newColor = Color3.fromRGB(200, 50, 50)
    end
    
    HitboxToggle.BackgroundColor3 = newColor
    HitboxToggle:SetAttribute("BaseColor", newColor)
    
    for _, child in ipairs(HitboxToggle.Parent:GetChildren()) do
        if child:IsA("ImageLabel") and child.Name == "NeonGlow_" .. HitboxToggle.Name then
            child.ImageColor3 = newColor
        end
    end
    
    if hitboxActive then
        originalPartSizes = {}
        hitboxConnection = RunService.RenderStepped:Connect(function()
            local char = player.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and (part.Name == "Handle" or part.Name == "Glove" or part.Name == "RightHand") then
                        if not originalPartSizes[part] then
                            originalPartSizes[part] = {
                                Size = part.Size,
                                Transparency = part.Transparency,
                                CanCollide = part.CanCollide
                            }
                        end
                        
                        local dividedX = hitboxSizeX / math.max(1, glovesCount)
                        local dividedY = hitboxSizeY / math.max(1, glovesCount)
                        local dividedZ = hitboxSizeZ / math.max(1, glovesCount)
                        
                        part.Size = Vector3.new(dividedX, dividedY, dividedZ)
                        part.Transparency = hitboxTransparency
                        part.CanCollide = false
                        part.Massless = true
                    end
                end
            end
        end)
    else
        if hitboxConnection then
            hitboxConnection:Disconnect()
            hitboxConnection = nil
        end
        
        for part, data in pairs(originalPartSizes) do
            if part and part.Parent then
                part.Size = data.Size
                part.Transparency = data.Transparency
                part.CanCollide = data.CanCollide
            end
        end
        originalPartSizes = {}
    end
end)
