local function selectIsland(name, pos)
    if isAnimating then return end
    isAnimating = true
    selectedIslandName = name
    selectedPosition = pos
    dropdownOpen = false
    DropdownToggle.Text = "Select Island v (" .. selectedIslandName .. ")"
    
    TweenService:Create(MainFrame, closeTweenInfo, {Size = UDim2.new(0, 230, 0, 520)}):Play()
    TweenService:Create(IslandsContainer, closeTweenInfo, {Size = UDim2.new(0, 184, 0, 0)}):Play()
    TweenService:Create(GoBtn, closeTweenInfo, {Position = UDim2.new(0.5, -92, 0, 404)}):Play()
    TweenService:Create(AntiKBBtn, closeTweenInfo, {Position = UDim2.new(0.5, -92, 0, 444)}):Play()
    
    for _, item in ipairs(subItems) do
        local closeTweenBtn = TweenService:Create(item.btn, closeTweenInfo, {
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            TextTransparency = 1,
            Size = UDim2.new(0, 184, 0, 26),
            BackgroundColor3 = item.btn:GetAttribute("BaseColor") or Color3.fromRGB(80, 80, 110)
        })
        closeTweenBtn:Play()
        
        local closeTweenGlow = TweenService:Create(item.glow, closeTweenInfo, {
            ImageTransparency = 1,
            Size = UDim2.new(0, 184 + 44, 0, 26 + 44),
            ImageColor3 = item.btn:GetAttribute("BaseColor") or Color3.fromRGB(80, 80, 110)
        })
        closeTweenGlow:Play()
    end
    
    task.delay(0.2, function() isAnimating = false end)
end

