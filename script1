local isAnimating = false

local function applyButtonEffects(btn, baseColor, originalSize, hoverSize, clickSize)
    local tweenInfoHover = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tweenInfoClick = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    for _, child in ipairs(btn.Parent:GetChildren()) do
        if child.Name == "NeonGlow_" .. btn.Name then
            child:Destroy()
        end
    end

    local glow = Instance.new("ImageLabel")
    glow.Name = "NeonGlow_" .. btn.Name
    glow.Parent = btn.Parent
    glow.BackgroundTransparency = 1
    glow.Image = "rbxassetid://6014261993"
    glow.ImageColor3 = baseColor
    glow.ImageTransparency = btn.BackgroundTransparency == 1 and 1 or 0.4
    glow.ScaleType = Enum.ScaleType.Slice
    glow.SliceCenter = Rect.new(49, 49, 450, 450)
    
    local glowPadding = 22
    glow.Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset + glowPadding * 2, originalSize.Y.Scale, originalSize.Y.Offset + glowPadding * 2)
    glow.Position = UDim2.new(0.5, -(originalSize.X.Offset + glowPadding * 2) / 2, btn.Position.Y.Scale, btn.Position.Y.Offset - glowPadding)
    glow.ZIndex = btn.ZIndex - 1

    local currentBtnTween, currentGlowTween

    btn:GetPropertyChangedSignal("BackgroundTransparency"):Connect(function()
        if btn.BackgroundTransparency == 1 then
            glow.ImageTransparency = 1
        end
    end)

    btn:GetPropertyChangedSignal("Position"):Connect(function()
        glow.Position = UDim2.new(0.5, -(glow.AbsoluteSize.X) / 2, btn.Position.Y.Scale, btn.Position.Y.Offset - glowPadding)
    end)

    local function getRealBaseColor()
        return btn:GetAttribute("BaseColor") or baseColor
    end

    btn.MouseEnter:Connect(function()
        if isAnimating or btn.BackgroundTransparency > 0.5 then return end

        if currentBtnTween then currentBtnTween:Cancel() end
        if currentGlowTween then currentGlowTween:Cancel() end

        local realBase = getRealBaseColor()
        local hoverColor = Color3.new(
            math.min(realBase.R + 0.1, 1),
            math.min(realBase.G + 0.1, 1),
            math.min(realBase.B + 0.1, 1)
        )

        currentBtnTween = TweenService:Create(btn, tweenInfoHover, {
            Size = hoverSize,
            Position = UDim2.new(0.5, -hoverSize.X.Offset / 2, btn.Position.Y.Scale, btn.Position.Y.Offset),
            BackgroundColor3 = hoverColor
        })
        currentBtnTween:Play()

        currentGlowTween = TweenService:Create(glow, tweenInfoHover, {
            Size = UDim2.new(0.0, hoverSize.X.Offset + glowPadding * 2 + 6, 0.0, hoverSize.Y.Offset + glowPadding * 2 + 6),
            Position = UDim2.new(0.5, -(hoverSize.X.Offset + glowPadding * 2 + 6) / 2, btn.Position.Y.Scale, btn.Position.Y.Offset - glowPadding - 3),
            ImageColor3 = hoverColor,
            ImageTransparency = 0.25
        })
        currentGlowTween:Play()
    end)

    btn.MouseLeave:Connect(function()
        if isAnimating or btn.BackgroundTransparency > 0.5 then return end

        if currentBtnTween then currentBtnTween:Cancel() end
        if currentGlowTween then currentGlowTween:Cancel() end

        local realBase = getRealBaseColor()

        currentBtnTween = TweenService:Create(btn, tweenInfoHover, {
            Size = originalSize,
            Position = UDim2.new(0.5, -originalSize.X.Offset / 2, btn.Position.Y.Scale, btn.Position.Y.Offset),
            BackgroundColor3 = realBase
        })
        currentBtnTween:Play()

        currentGlowTween = TweenService:Create(glow, tweenInfoHover, {
            Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset + glowPadding * 2, originalSize.Y.Scale, originalSize.Y.Offset + glowPadding * 2),
            Position = UDim2.new(0.5, -(originalSize.X.Offset + glowPadding * 2) / 2, btn.Position.Y.Scale, btn.Position.Y.Offset - glowPadding),
            ImageColor3 = realBase,
            ImageTransparency = 0.4
        })
        currentGlowTween:Play()
    end)

    btn.MouseButton1Down:Connect(function()
        if isAnimating or btn.BackgroundTransparency > 0.5 then return end
        if currentBtnTween then currentBtnTween:Cancel() end

        currentBtnTween = TweenService:Create(btn, tweenInfoClick, {
            Size = clickSize,
            Position = UDim2.new(0.5, -clickSize.X.Offset / 2, btn.Position.Y.Scale, btn.Position.Y.Offset)
        })
        currentBtnTween:Play()
    end)

    btn.MouseButton1Up:Connect(function()
        if isAnimating or btn.BackgroundTransparency > 0.5 then return end
        if currentBtnTween then currentBtnTween:Cancel() end

        currentBtnTween = TweenService:Create(btn, tweenInfoHover, {
            Size = hoverSize,
            Position = UDim2.new(0.5, -hoverSize.X.Offset / 2, btn.Position.Y.Scale, btn.Position.Y.Offset)
        })
        currentBtnTween:Play()
    end)

    return glow
end

local function createButton(name, posY, height, color)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = MainFrame
    btn.BackgroundColor3 = color
    btn.BorderSizePixel = 0
    btn.ZIndex = 2
    
    btn:SetAttribute("BaseColor", color)
    
    local origSize = UDim2.new(0, 184, 0, height)
    local hoverSize = UDim2.new(0, 194, 0, height + 4)
    local clickSize = UDim2.new(0, 176, 0, height - 3)
    
    btn.Position = UDim2.new(0.5, -origSize.X.Offset / 2, 0, posY)
    btn.Size = origSize
    btn.Font = Enum.Font.GothamBold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    
    applyButtonEffects(btn, color, origSize, hoverSize, clickSize)
    
    return btn
end

