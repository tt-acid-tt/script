--============================================================
-- MUSIC SYSTEM
--============================================================

local musicLibrary = {}
local currentMusicIndex = 0
local musicVolume = 0.5
local currentMusicSound = nil
local musicPlaying = false

local function destroyCurrentMusic()

	if currentMusicSound then

		pcall(function()
			currentMusicSound:Stop()
		end)

		currentMusicSound:Destroy()
		currentMusicSound = nil
	end

	musicPlaying = false
end

local function playMusicIndex(index)

	if #musicLibrary == 0 then
		return
	end

	if index < 1 then
		index = #musicLibrary
	end

	if index > #musicLibrary then
		index = 1
	end

	currentMusicIndex = index

	local data = musicLibrary[currentMusicIndex]

	if not data then
		return
	end

	destroyCurrentMusic()

	local sound = Instance.new("Sound")
	sound.Name = "HubMusic"
	sound.SoundId = "rbxassetid://" .. tostring(data.id)
	sound.Volume = musicVolume
	sound.Looped = false
	sound.Parent = SoundService

	currentMusicSound = sound
	musicPlaying = true

	sound.Ended:Connect(function()

		if currentMusicSound ~= sound then
			return
		end

		if #musicLibrary > 0 then
			local nextIndex = currentMusicIndex + 1

			if nextIndex > #musicLibrary then
				nextIndex = 1
			end

			playMusicIndex(nextIndex)
		end
	end)

	sound:Play()
end

local function toggleMusic()

	if not currentMusicSound then

		if #musicLibrary > 0 then
			playMusicIndex(
				math.max(currentMusicIndex, 1)
			)
		end

		return
	end

	if currentMusicSound.IsPlaying then

		currentMusicSound:Pause()
		musicPlaying = false

	else

		currentMusicSound:Resume()
		musicPlaying = true
	end
end

local function nextMusic()

	if #musicLibrary == 0 then
		return
	end

	local nextIndex = currentMusicIndex + 1

	if nextIndex > #musicLibrary then
		nextIndex = 1
	end

	playMusicIndex(nextIndex)
end

local function previousMusic()

	if #musicLibrary == 0 then
		return
	end

	local previousIndex = currentMusicIndex - 1

	if previousIndex < 1 then
		previousIndex = #musicLibrary
	end

	playMusicIndex(previousIndex)
end

local function removeMusic(index)

	if not musicLibrary[index] then
		return
	end

	local wasCurrent = index == currentMusicIndex

	table.remove(
		musicLibrary,
		index
	)

	if #musicLibrary == 0 then

		currentMusicIndex = 0
		destroyCurrentMusic()
		return
	end

	if index < currentMusicIndex then
		currentMusicIndex -= 1

	elseif index == currentMusicIndex then

		if currentMusicIndex > #musicLibrary then
			currentMusicIndex = 1
		end

		if wasCurrent then
			playMusicIndex(currentMusicIndex)
		end
	end
end

