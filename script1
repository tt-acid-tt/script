local function createSubButton(name, posY, color)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = IslandsContainer
    btn.BackgroundColor3 = color
    btn.BorderSizePixel = 0
    btn.ZIndex = 2
    
    btn:SetAttribute("BaseColor", color)
    
    local origSize = UDim2.new(0, 184, 0, 26)
    local hoverSize = UDim2.new(0, 192, 0, 29)
    local clickSize = UDim2.new(0, 176, 0, 23)
    
    btn.Position = UDim2.new(0, 0, 0, posY)
    btn.Size = origSize
    btn.Font = Enum.Font.GothamBold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 11
    btn.TextTransparency = 1
    btn.BackgroundTransparency = 1
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    local glow = applyButtonEffects(btn, color, origSize, hoverSize, clickSize)
    
    return btn, glow
end

