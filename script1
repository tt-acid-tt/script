player.CharacterAdded:Connect(function()
    task.wait(0.2)

    if flying then
        disableFly()
    end
end)

--=========================================================
-- COMPLETE SHUTDOWN
--
-- The original HUB has its own CloseBtn which destroys
-- SlapBattlesAntiVoidGUI. This watcher catches that event
-- and shuts down Fly too.
--=========================================================

local shuttingDown = false

local function shutdownAll()
    if shuttingDown then
        return
    end

    shuttingDown = true

    -- Fly
    flyMenuOpen = false
    bindingFly = false
    bindingMinimize = false

    if flying then
        disableFly()
    else
        if bodyVelocity then
            bodyVelocity:Destroy()
            bodyVelocity = nil
        end

        if bodyGyro then
            bodyGyro:Destroy()
            bodyGyro = nil
        end

        if humanoid then
            humanoid.PlatformStand = false
        end
    end

    -- Original functions:
    -- We cannot safely access every local from script1,
    -- so we force the original GUI to disappear, which
    -- also terminates its GUI-side controls.
    --
    -- Anti-Void platform cleanup is handled by the original
    -- CloseBtn in script1.

    if flyGui and flyGui.Parent then
        flyGui:Destroy()
    end

    if clickSound and clickSound.Parent then
        clickSound:Destroy()
    end
end

mainGui.Destroying:Connect(shutdownAll)

mainGui.AncestryChanged:Connect(function(_, parent)
    if not parent then
        shutdownAll()
    end
end)

