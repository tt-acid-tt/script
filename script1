-- ЛОГИКА ANTI-KNOCKBACK (Удаление физических сил от ударов)
local function setupAntiKnockback(char)
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    local function checkAndDestroy(child)
        if antiKnockbackEnabled then
            if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") or child:IsA("VectorForce") or child:IsA("BodyThrust") then
                task.wait()
                child:Destroy()
            end
        end
    end

    char.ChildAdded:Connect(checkAndDestroy)
    hrp.ChildAdded:Connect(checkAndDestroy)
end

if player.Character then
    setupAntiKnockback(player.Character)
end
player.CharacterAdded:Connect(setupAntiKnockback)

-- Сброс аномально высокой скорости (дополнительная страховка)
