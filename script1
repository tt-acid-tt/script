local function styleTab(tab, active)

	TweenService:Create(
		tab,
		TweenInfo.new(
			0.2,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		{
			BackgroundColor3 =
				active
				and Color3.fromRGB(
					65,
					95,
					170
				)
				or Color3.fromRGB(
					36,
					36,
					50
				),

			TextColor3 =
				active
				and Color3.new(
					1,
					1,
					1
				)
				or Color3.fromRGB(
					185,
					185,
					205
				)
		}
	):Play()
end

local function cancelPageTween(page)

	local tween =
		pageTweens[page]

	if tween then
		tween:Cancel()
		pageTweens[page] = nil
	end
end

local function animatePageIn(
	page,
	direction
)

	cancelPageTween(page)

	page.Visible = true

	page.Position =
		UDim2.new(
			0,
			12 + direction * 42,
			0,
			10
		)

	local tween =
		TweenService:Create(
			page,
			TweenInfo.new(
				0.30,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.Out
			),
			{
				Position =
					UDim2.new(
						0,
						12,
						0,
						10
					)
			}
		)

	pageTweens[page] = tween

	tween.Completed:Connect(function()

		if pageTweens[page] == tween then
			pageTweens[page] = nil
		end

		if page ~= pages[currentTab] then

			page.Visible = false

			page.Position =
				UDim2.new(
					0,
					12,
					0,
					10
				)
		end
	end)

	tween:Play()
end

local function animatePageOut(
	page,
	direction
)

	cancelPageTween(page)

	local tween =
		TweenService:Create(
			page,
			TweenInfo.new(
				0.20,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.In
			),
			{
				Position =
					UDim2.new(
						0,
						12 - direction * 42,
						0,
						10
					)
			}
		)

	pageTweens[page] = tween

	tween.Completed:Connect(function()

		if pageTweens[page] == tween then
			pageTweens[page] = nil
		end

		if page ~= pages[currentTab] then

			page.Visible = false

			page.Position =
				UDim2.new(
					0,
					12,
					0,
					10
				)
		end
	end)

	tween:Play()
end

local function setTab(name)

	if not pages[name] then
		return
	end

	if name == currentTab then
		return
	end

	local oldName =
		currentTab

	local oldPage =
		pages[oldName]

	local newPage =
		pages[name]

	local direction

	if tabIndexes[name] >
		tabIndexes[oldName]
	then

		direction = 1

	else

		direction = -1
	end

	currentTab = name

	cancelPageTween(oldPage)
	cancelPageTween(newPage)

	newPage.Visible = true

	newPage.CanvasPosition =
		Vector2.new(
			0,
			0
		)

	newPage.Position =
		UDim2.new(
			0,
			12 + direction * 42,
			0,
			10
		)

	for tabName, tab in pairs(tabs) do

		styleTab(
			tab,
			tabName == currentTab
		)
	end

	animatePageIn(
		newPage,
		direction
	)

	if oldPage
		and oldPage ~= newPage
	then

		animatePageOut(
			oldPage,
			direction
		)
	end
end

