--============================================================
-- SMOOTH SCROLLING
--============================================================

local scrollTweens = {}

local function smoothScroll(page, delta)

	if not page.Visible then
		return
	end

	local maxY = math.max(
		0,
		page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y
	)

	local target = math.clamp(
		page.CanvasPosition.Y + delta,
		0,
		maxY
	)

	if scrollTweens[page] then
		scrollTweens[page]:Cancel()
	end

	local tween = TweenService:Create(
		page,
		TweenInfo.new(
			0.22,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		{
			CanvasPosition = Vector2.new(0, target)
		}
	)

	scrollTweens[page] = tween

	tween.Completed:Connect(function()

		if scrollTweens[page] == tween then
			scrollTweens[page] = nil
		end
	end)

	tween:Play()
end

for _, page in ipairs({
	MainPage,
	TeleportPage,
	SettingsPage,
	GUIPage,
	MusicPage
}) do

	page.InputChanged:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseWheel then

			smoothScroll(
				page,
				-input.Position.Z * 70
			)
		end
	end)
end

