--============================================================

local function isKBMover(obj)

	return
		obj:IsA("BodyVelocity")
		or obj:IsA("BodyPosition")
		or obj:IsA("BodyThrust")
		or obj:IsA("BodyAngularVelocity")
		or obj:IsA("VectorForce")
		or obj:IsA("AngularVelocity")
end

local function cleanKB(c)

	for _, obj in ipairs(
		c:GetDescendants()
	) do

		if isKBMover(obj) then
			obj:Destroy()
		end
	end
end

local function forceNormal(h)

	if not h then
		return
	end

	local s =
		h:GetState()

	if
		s == Enum.HumanoidStateType.Ragdoll
		or
		s == Enum.HumanoidStateType.FallingDown
		or
		s == Enum.HumanoidStateType.Physics
	then

		h:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)
	end

	h.PlatformStand = false
end

local function setupAntiKB(c)

	if not c then
		return
	end

	if antiKBChildConnection then
		antiKBChildConnection:Disconnect()
		antiKBChildConnection = nil
	end

	if antiKBStateConnection then
		antiKBStateConnection:Disconnect()
		antiKBStateConnection = nil
	end

	local h =
		c:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		c:FindFirstChild(
			"HumanoidRootPart"
		)

	if not h
		or not root
	then
		return
	end

	for _, obj in ipairs(
		c:GetDescendants()
	) do

		if isKBMover(obj) then
			obj:Destroy()
		end
	end

	pcall(function()

		h:SetStateEnabled(
			Enum.HumanoidStateType.Ragdoll,
			false
		)

		h:SetStateEnabled(
			Enum.HumanoidStateType.FallingDown,
			false
		)

		h:SetStateEnabled(
			Enum.HumanoidStateType.Physics,
			false
		)
	end)

	forceNormal(h)

	antiKBStateConnection =
		h.StateChanged:Connect(
			function(_, newState)

				if not antiKBActive then
					return
				end

				if
					newState ==
						Enum.HumanoidStateType.Ragdoll
					or
					newState ==
						Enum.HumanoidStateType.FallingDown
					or
					newState ==
						Enum.HumanoidStateType.Physics
				then

					task.defer(function()

						if h.Parent
							and antiKBActive
						then

							forceNormal(h)
						end
					end)
				end
			end
		)

	antiKBChildConnection =
		c.DescendantAdded:Connect(
			function(obj)

				if not antiKBActive then
					return
				end

				if obj:IsA("LinearVelocity")
					or obj:IsA("AlignOrientation")
				then

					if obj.Parent == root then
						return
					end
				end

				if isKBMover(obj) then

					task.defer(function()

						if obj.Parent
							and antiKBActive
						then

							if obj:IsA("LinearVelocity")
								or obj:IsA("AlignOrientation")
							then

								if obj.Parent == root then
									return
								end
							end

							obj:Destroy()
						end
					end)
				end
			end
		)
end

local function enableAntiKB()

	antiKBActive = true

	if player.Character then
		setupAntiKB(
			player.Character
		)
	end

	if antiKBConnection then
		antiKBConnection:Disconnect()
	end

	antiKBConnection =
		RunService.RenderStepped:Connect(
			function()

				if not antiKBActive then
					return
				end

				local c =
					player.Character

				local h =
					c
					and c:FindFirstChildOfClass(
						"Humanoid"
					)

				local root =
					c
					and c:FindFirstChild(
						"HumanoidRootPart"
					)

				if not h
					or not root
				then
					return
				end

				local flyLinear =
					root:FindFirstChildOfClass(
						"LinearVelocity"
					)

				local flyAlign =
					root:FindFirstChildOfClass(
						"AlignOrientation"
					)

				if not flyLinear
					and not flyAlign
				then

					cleanKB(c)

					forceNormal(h)

					local move =
						h.MoveDirection *
						h.WalkSpeed

					root.AssemblyLinearVelocity =
						Vector3.new(
							move.X,
							root.AssemblyLinearVelocity.Y,
							move.Z
						)

					root.AssemblyAngularVelocity =
						Vector3.zero
				end
			end
		)
end

local function disableAntiKB()

	antiKBActive = false

	if antiKBConnection then
		antiKBConnection:Disconnect()
		antiKBConnection = nil
	end

	if antiKBChildConnection then
		antiKBChildConnection:Disconnect()
		antiKBChildConnection = nil
	end

	if antiKBStateConnection then
		antiKBStateConnection:Disconnect()
		antiKBStateConnection = nil
	end

	local c =
		player.Character

	local h =
		c
		and c:FindFirstChildOfClass(
			"Humanoid"
		)

	if h then

		pcall(function()

			h:SetStateEnabled(
				Enum.HumanoidStateType.Ragdoll,
				true
			)

			h:SetStateEnabled(
				Enum.HumanoidStateType.FallingDown,
				true
			)

			h:SetStateEnabled(
				Enum.HumanoidStateType.Physics,
				true
			)
		end)
	end
end

