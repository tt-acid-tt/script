ResizeHandle.MouseButton1Down:Connect(function()

	if minimized then
		return
	end

	if not MainFrame.Visible then
		return
	end

	resizing = true

	resizeStartMouse =
		UserInputService:GetMouseLocation()

	resizeStartWidth =
		currentWidth

	resizeStartHeight =
		currentHeight

	if resizeConnection then
		resizeConnection:Disconnect()
	end

	resizeConnection =
		RunService.RenderStepped:Connect(
			function()

				if not resizing then
					return
				end

				local mousePos =
					UserInputService:GetMouseLocation()

				local delta =
					mousePos -
					resizeStartMouse

				local newWidth =
					math.clamp(
						resizeStartWidth +
							delta.X,
						MIN_WIDTH,
						MAX_WIDTH
					)

				local newHeight =
					math.clamp(
						resizeStartHeight +
							delta.Y,
						MIN_HEIGHT,
						MAX_HEIGHT
					)

				local widthDifference =
					newWidth -
					currentWidth

				local heightDifference =
					newHeight -
					currentHeight

				currentWidth =
					newWidth

				currentHeight =
					newHeight

				local currentPos =
					MainFrame.Position

				MainFrame.Size =
					UDim2.new(
						0,
						math.floor(
							currentWidth
						),
						0,
						math.floor(
							currentHeight
						)
					)

				MainFrame.Position =
					UDim2.new(
						currentPos.X.Scale,
						currentPos.X.Offset +
							widthDifference / 2,

						currentPos.Y.Scale,
						currentPos.Y.Offset +
							heightDifference / 2
					)
			end
		)
end)

