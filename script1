-- Логика Анти-Кнокбэка (Anti-Knockback)
local antiKBActive = false
local antiKBConnection = nil
local antiKBChildConnection = nil

AntiKBBtn.MouseButton1Click:Connect(function()
    antiKBActive = not antiKBActive
    
    local newColor
    if antiKBActive then
        AntiKBBtn.Text = "Anti-KB: ON"
        newColor = Color3.fromRGB(45, 180, 45)
    else
        AntiKBBtn.Text = "Anti-KB: OFF"
        newColor = Color3.fromRGB(200, 50, 50)
    end
    
    AntiKBBtn.BackgroundColor3 = newColor
    AntiKBBtn:SetAttribute("BaseColor", newColor)
    
    for _, child in ipairs(AntiKBBtn.Parent:GetChildren()) do
        if child:IsA("ImageLabel") and child.Name == "NeonGlow_" .. AntiKBBtn.Name then
            child.ImageColor3 = newColor
        end
    end
    
    if antiKBActive then
        local function checkAndRemoveMovers(character)
            if not character then return end
            for _, obj in ipairs(character:GetDescendants()) do
                if obj:IsA("BodyVelocity") or obj:IsA("BodyPosition") or obj:IsA("BodyThrust") or obj:IsA("LinearVelocity") or obj:IsA("VectorForce") then
                    obj:Destroy()
                end
            end
        end

        local char = player.Character
        if char then
            checkAndRemoveMovers(char)
            antiKBChildConnection = char.DescendantAdded:Connect(function(descendant)
                if descendant:IsA("BodyVelocity") or descendant:IsA("BodyPosition") or descendant:IsA("BodyThrust") or descendant:IsA("LinearVelocity") or descendant:IsA("VectorForce") then
                    task.defer(function()
                        if descendant and descendant.Parent then
                            descendant:Destroy()
                        end
                    end)
                end
            end)
        end

        antiKBConnection = RunService.Heartbeat:Connect(function()
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local hrp = character.HumanoidRootPart
                local velocity = hrp.AssemblyLinearVelocity
                local horizontalVel = Vector3.new(velocity.X, 0, velocity.Z)
                
                -- Если горизональная скорость резко возрастает выше нормального бега (от удара)
                if horizontalVel.Magnitude > 30 then
                    hrp.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
                end
            end
        end)
    else
        if antiKBConnection then
            antiKBConnection:Disconnect()
            antiKBConnection = nil
        end
        if antiKBChildConnection then
            antiKBChildConnection:Disconnect()
            antiKBChildConnection = nil
        end
    end
end)

