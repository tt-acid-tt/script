--============================================================
-- CLOSE / CLEANUP
--============================================================

local function cleanup()

	destroyCurrentMusic()

	for _, tween in pairs(
		pageTweens
	) do

		if tween then
			tween:Cancel()
		end
	end

	for _, tween in pairs(
		scrollTweens
	) do

		if tween then
			tween:Cancel()
		end
	end

	if antiVoidConnection then
		antiVoidConnection:Disconnect()
	end

	if tpConnection then
		tpConnection:Disconnect()
	end

	if hitboxConnection then
		hitboxConnection:Disconnect()
	end

	if antiKBConnection then
		antiKBConnection:Disconnect()
	end

	if antiKBChildConnection then
		antiKBChildConnection:Disconnect()
	end

	if antiKBStateConnection then
		antiKBStateConnection:Disconnect()
	end

	if antiKBCharacterConnection then
		antiKBCharacterConnection:Disconnect()
	end

	if resizeConnection then
		resizeConnection:Disconnect()
	end

	if safePlatform then
		safePlatform:Destroy()
	end

	local flyGui =
		playerGui:FindFirstChild(
			"FlyMenuGui"
		)

	if flyGui then

		local signal =
			flyGui:FindFirstChild(
				"DestroySignal"
			)

		if signal
			and signal:IsA("BindableEvent")
		then

			signal:Fire()
		end

		flyGui:Destroy()
	end

	ScreenGui:Destroy()
end

CloseBtn.MouseButton1Click:Connect(
	cleanup
)

--============================================================
-- RIGHT SHIFT
--============================================================

UserInputService.InputBegan:Connect(
	function(
		input,
		processed
	)

		if processed then
			return
		end

		if input.KeyCode ==
			Enum.KeyCode.RightShift
		then

			if minimized then
				restoreMainGUI()
			else
				MainFrame.Visible =
					not MainFrame.Visible
			end
		end
	end
)

