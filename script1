local function closeFlyMenu()
    bindingFly = false
    bindingMinimize = false

    if flying then
        disableFly()
    end

    flyMenuOpen = false
    flyToggle.Text = "FLY: OFF"

    flyMenuButton.Text = "FLY MENU"

    TweenService:Create(
        flyMenuButton,
        TweenInfo.new(
            0.22,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            BackgroundColor3 =
                Color3.fromRGB(70, 70, 95)
        }
    ):Play()

    -- Красивое закрытие: уменьшение + уход вниз + fade-out.
    prepareFlyAnimation(false)

    task.delay(0.26, function()
        if not flyMenuOpen then
            flyFrame.Visible = false
        end
    end)
end

local function openFlyMenu()
    flyMenuOpen = true
    flyMinimized = false

    content.Visible = true
    minimizeButton.Text = "-"

    flyFrame.Size = UDim2.new(0, 230, 0, 202)

    -- Начальное состояние pop-in.
    flyFrame.Position = flyClosedPosition
    flyScale.Scale = 0.86
    flyFrame.BackgroundTransparency = 1
    flyStroke.Transparency = 1

    for _, obj in ipairs(flyFrame:GetDescendants()) do
        if obj:IsA("TextLabel")
            or obj:IsA("TextButton")
            or obj:IsA("TextBox") then

            obj.TextTransparency = 1

        elseif obj:IsA("UIStroke") then

            obj.Transparency = 1
        end
    end

    flyFrame.Visible = true

    flyMenuButton.Text = "FLY MENU: ON"

    TweenService:Create(
        flyMenuButton,
        TweenInfo.new(
            0.22,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            BackgroundColor3 =
                Color3.fromRGB(40, 70, 48)
        }
    ):Play()

    -- Красивое появление: pop + fade + движение снизу.
    prepareFlyAnimation(true)
end

