local function button(parent, name, text, color, height)

	height = height or 38

	local b = Instance.new("TextButton")
	b.Name = name
	b.Parent = parent
	b.Size = UDim2.new(1, -8, 0, height)
	b.BackgroundColor3 = color
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Font = Enum.Font.GothamBold
	b.Text = text
	b.TextColor3 = Color3.new(1, 1, 1)
	b.TextSize = 11
	b.ZIndex = 4

	b:SetAttribute("BaseColor", color)

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 9)
	c.Parent = b

	local glow = Instance.new("Frame")
	glow.Name = "ButtonGlow"
	glow.Parent = b
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.new(0.5, 0, 0.5, 0)
	glow.Size = UDim2.new(1, 8, 1, 8)
	glow.BackgroundColor3 = color
	glow.BackgroundTransparency = 0.82
	glow.BorderSizePixel = 0
	glow.ZIndex = 3

	local gc = Instance.new("UICorner")
	gc.CornerRadius = UDim.new(0, 11)
	gc.Parent = glow

	b.MouseEnter:Connect(function()

		local base = b:GetAttribute("BaseColor") or color

		local hover = Color3.new(
			math.min(base.R + 0.08, 1),
			math.min(base.G + 0.08, 1),
			math.min(base.B + 0.08, 1)
		)

		TweenService:Create(
			b,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 = hover
			}
		):Play()

		TweenService:Create(
			glow,
			TweenInfo.new(0.15),
			{
				BackgroundTransparency = 0.65
			}
		):Play()
	end)

	b.MouseLeave:Connect(function()

		local base = b:GetAttribute("BaseColor") or color

		TweenService:Create(
			b,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 = base
			}
		):Play()

		TweenService:Create(
			glow,
			TweenInfo.new(0.15),
			{
				BackgroundTransparency = 0.82
			}
		):Play()
	end)

	b.MouseButton1Down:Connect(function()

		TweenService:Create(
			b,
			TweenInfo.new(0.07),
			{
				Size = UDim2.new(
					1,
					-14,
					0,
					math.max(height - 3, 20)
				)
			}
		):Play()
	end)

	b.MouseButton1Up:Connect(function()

		TweenService:Create(
			b,
			TweenInfo.new(0.1),
			{
				Size = UDim2.new(
					1,
					-8,
					0,
					height
				)
			}
		):Play()
	end)

	return b
end

local function slider(
	parent,
	text,
	minValue,
	maxValue,
	defaultValue,
	callback
)

	local f = Instance.new("Frame")
	f.Parent = parent
	f.Size = UDim2.new(1, -8, 0, 52)
	f.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
	f.BorderSizePixel = 0
	f.ZIndex = 4

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 9)
	c.Parent = f

	local label = Instance.new("TextLabel")
	label.Parent = f
	label.Position = UDim2.new(0, 12, 0, 6)
	label.Size = UDim2.new(1, -24, 0, 17)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Gotham
	label.Text = text .. ": " .. tostring(defaultValue)
	label.TextColor3 = Color3.fromRGB(180, 180, 200)
	label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 5

	local track = Instance.new("Frame")
	track.Parent = f
	track.Position = UDim2.new(0, 12, 0, 34)
	track.Size = UDim2.new(1, -24, 0, 6)
	track.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
	track.BorderSizePixel = 0
	track.ZIndex = 5

	local tc = Instance.new("UICorner")
	tc.CornerRadius = UDim.new(1, 0)
	tc.Parent = track

	local pctDefault =
		(defaultValue - minValue) /
		(maxValue - minValue)

	local fill = Instance.new("Frame")
	fill.Parent = track
	fill.Size = UDim2.new(pctDefault, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(80, 130, 255)
	fill.BorderSizePixel = 0
	fill.ZIndex = 5

	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(1, 0)
	fc.Parent = fill

	local knob = Instance.new("TextButton")
	knob.Parent = track
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(pctDefault, 0, 0.5, 0)
	knob.Size = UDim2.new(0, 12, 0, 12)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Text = ""
	knob.ZIndex = 6

	local kc = Instance.new("UICorner")
	kc.CornerRadius = UDim.new(1, 0)
	kc.Parent = knob

	local dragging = false

	knob.MouseButton1Down:Connect(function()
		dragging = true
	end)

	UserInputService.InputEnded:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)

		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then

			return
		end

		local pct = math.clamp(
			(input.Position.X - track.AbsolutePosition.X) /
				math.max(track.AbsoluteSize.X, 1),
			0,
			1
		)

		local value =
			minValue +
			(maxValue - minValue) * pct

		value = math.floor(value * 10 + 0.5) / 10

		fill.Size = UDim2.new(pct, 0, 1, 0)
		knob.Position = UDim2.new(pct, 0, 0.5, 0)

		label.Text = text .. ": " .. tostring(value)

		callback(value)
	end)
end

