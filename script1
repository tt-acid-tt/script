--// =========================================================
--// ANTI-KNOCKBACK
--// =========================================================

local function isKnockbackMover(obj)

	return obj:IsA("BodyVelocity")
		or obj:IsA("BodyPosition")
		or obj:IsA("BodyThrust")
		or obj:IsA("BodyAngularVelocity")
		or obj:IsA("LinearVelocity")
		or obj:IsA("VectorForce")
		or obj:IsA("AngularVelocity")
end

local function cleanKnockbackMovers(character)

	if not character then
		return
	end

	for _, obj in ipairs(character:GetDescendants()) do

		if isKnockbackMover(obj) then
			obj:Destroy()
		end
	end
end

local function forceNormalHumanoidState(humanoid)

	if not humanoid then
		return
	end

	local state = humanoid:GetState()

	if state == Enum.HumanoidStateType.Ragdoll
		or state == Enum.HumanoidStateType.FallingDown
		or state == Enum.HumanoidStateType.Physics then

		humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)
	end

	if humanoid.PlatformStand then
		humanoid.PlatformStand = false
	end
end

local function setupAntiKB(character)

	if not character then
		return
	end

	if antiKBChildConnection then
		antiKBChildConnection:Disconnect()
		antiKBChildConnection = nil
	end

	if antiKBStateConnection then
		antiKBStateConnection:Disconnect()
		antiKBStateConnection = nil
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return
	end

	-- Удаляем существующие силы.
	cleanKnockbackMovers(character)

	-- Блокируем стандартные состояния.
	pcall(function()

		humanoid:SetStateEnabled(
			Enum.HumanoidStateType.Ragdoll,
			false
		)

		humanoid:SetStateEnabled(
			Enum.HumanoidStateType.FallingDown,
			false
		)

		humanoid:SetStateEnabled(
			Enum.HumanoidStateType.Physics,
			false
		)

	end)

	forceNormalHumanoidState(humanoid)

	--// Отслеживаем смену состояния.
	antiKBStateConnection =
		humanoid.StateChanged:Connect(
			function(_, newState)

				if not antiKBActive then
					return
				end

				if newState ==
					Enum.HumanoidStateType.Ragdoll
					or newState ==
					Enum.HumanoidStateType.FallingDown
					or newState ==
					Enum.HumanoidStateType.Physics then

					task.defer(function()

						if humanoid
							and humanoid.Parent
							and antiKBActive then

							forceNormalHumanoidState(
								humanoid
							)
						end
					end)
				end
			end
		)

	--// Удаляем новые knockback-объекты.
	antiKBChildConnection =
		character.DescendantAdded:Connect(
			function(obj)

				if not antiKBActive then
					return
				end

				if isKnockbackMover(obj) then

					task.defer(function()

						if obj
							and obj.Parent
							and antiKBActive then

							obj:Destroy()
						end
					end)
				end
			end
		)
end

local function enableAntiKB()

	antiKBActive = true

	local character = player.Character

	if character then
		setupAntiKB(character)
	end

	if antiKBConnection then
		antiKBConnection:Disconnect()
	end

	--// RenderStepped используется для максимально
	--// быстрой коррекции горизонтального knockback.
	antiKBConnection =
		RunService.RenderStepped:Connect(function()

			if not antiKBActive then
				return
			end

			local currentCharacter =
				player.Character

			if not currentCharacter then
				return
			end

			local humanoid =
				currentCharacter:FindFirstChildOfClass(
					"Humanoid"
				)

			local root =
				currentCharacter:FindFirstChild(
					"HumanoidRootPart"
				)

			if not humanoid or not root then
				return
			end

			-- Удаляем физические силы.
			cleanKnockbackMovers(
				currentCharacter
			)

			-- Блокируем ragdoll.
			forceNormalHumanoidState(
				humanoid
			)

			-- Берём ТЕКУЩУЮ скорость Humanoid.
			-- Поэтому если у игрока WalkSpeed = 16,
			-- он остаётся 16. Если админ установил 20,
			-- остаётся 20.
			local walkSpeed =
				humanoid.WalkSpeed

			local moveDirection =
				humanoid.MoveDirection

			-- Сохраняем вертикальную физику,
			-- чтобы прыжок продолжал работать.
			local currentVelocity =
				root.AssemblyLinearVelocity

			local horizontalVelocity =
				moveDirection * walkSpeed

			root.AssemblyLinearVelocity =
				Vector3.new(
					horizontalVelocity.X,
					currentVelocity.Y,
					horizontalVelocity.Z
				)

			-- Удар больше не может раскрутить персонажа.
			root.AssemblyAngularVelocity =
				Vector3.zero
		end)
end

local function disableAntiKB()

	antiKBActive = false

	if antiKBConnection then
		antiKBConnection:Disconnect()
		antiKBConnection = nil
	end

	if antiKBChildConnection then
		antiKBChildConnection:Disconnect()
		antiKBChildConnection = nil
	end

	if antiKBStateConnection then
		antiKBStateConnection:Disconnect()
		antiKBStateConnection = nil
	end

	local character = player.Character

	if character then

		local humanoid =
			character:FindFirstChildOfClass(
				"Humanoid"
			)

		if humanoid then

			pcall(function()

				humanoid:SetStateEnabled(
					Enum.HumanoidStateType.Ragdoll,
					true
				)

				humanoid:SetStateEnabled(
					Enum.HumanoidStateType.FallingDown,
					true
				)

				humanoid:SetStateEnabled(
					Enum.HumanoidStateType.Physics,
					true
				)

			end)
		end
	end
end

