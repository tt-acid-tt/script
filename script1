--// =========================================================
--// BUTTON EFFECTS
--// =========================================================

local function applyButtonEffects(btn, baseColor, originalSize, hoverSize, clickSize)

	local tweenInfoHover = TweenInfo.new(
		0.25,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	local tweenInfoClick = TweenInfo.new(
		0.1,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	local glow = Instance.new("ImageLabel")
	glow.Name = "NeonGlow_" .. btn.Name
	glow.Parent = btn.Parent
	glow.BackgroundTransparency = 1
	glow.Image = "rbxassetid://6014261993"
	glow.ImageColor3 = baseColor
	glow.ImageTransparency = 0.4
	glow.ScaleType = Enum.ScaleType.Slice
	glow.SliceCenter = Rect.new(49, 49, 450, 450)
	glow.ZIndex = btn.ZIndex - 1

	local glowPadding = 22

	glow.Size = UDim2.new(
		0,
		originalSize.X.Offset + glowPadding * 2,
		0,
		originalSize.Y.Offset + glowPadding * 2
	)

	glow.Position = UDim2.new(
		0.5,
		-(originalSize.X.Offset + glowPadding * 2) / 2,
		btn.Position.Y.Scale,
		btn.Position.Y.Offset - glowPadding
	)

	local currentBtnTween
	local currentGlowTween

	local function getBaseColor()
		return btn:GetAttribute("BaseColor") or baseColor
	end

	btn.MouseEnter:Connect(function()

		if isAnimating then
			return
		end

		if btn.BackgroundTransparency > 0.5 then
			return
		end

		if currentBtnTween then
			currentBtnTween:Cancel()
		end

		if currentGlowTween then
			currentGlowTween:Cancel()
		end

		local realBase = getBaseColor()

		local hoverColor = Color3.new(
			math.min(realBase.R + 0.1, 1),
			math.min(realBase.G + 0.1, 1),
			math.min(realBase.B + 0.1, 1)
		)

		currentBtnTween = TweenService:Create(
			btn,
			tweenInfoHover,
			{
				Size = hoverSize,
				Position = UDim2.new(
					0.5,
					-hoverSize.X.Offset / 2,
					btn.Position.Y.Scale,
					btn.Position.Y.Offset
				),
				BackgroundColor3 = hoverColor
			}
		)

		currentBtnTween:Play()

		currentGlowTween = TweenService:Create(
			glow,
			tweenInfoHover,
			{
				ImageColor3 = hoverColor,
				ImageTransparency = 0.25
			}
		)

		currentGlowTween:Play()
	end)

	btn.MouseLeave:Connect(function()

		if isAnimating then
			return
		end

		if btn.BackgroundTransparency > 0.5 then
			return
		end

		if currentBtnTween then
			currentBtnTween:Cancel()
		end

		if currentGlowTween then
			currentGlowTween:Cancel()
		end

		local realBase = getBaseColor()

		currentBtnTween = TweenService:Create(
			btn,
			tweenInfoHover,
			{
				Size = originalSize,
				Position = UDim2.new(
					0.5,
					-originalSize.X.Offset / 2,
					btn.Position.Y.Scale,
					btn.Position.Y.Offset
				),
				BackgroundColor3 = realBase
			}
		)

		currentBtnTween:Play()

		currentGlowTween = TweenService:Create(
			glow,
			tweenInfoHover,
			{
				ImageColor3 = realBase,
				ImageTransparency = 0.4
			}
		)

		currentGlowTween:Play()
	end)

	btn.MouseButton1Down:Connect(function()

		if isAnimating then
			return
		end

		if btn.BackgroundTransparency > 0.5 then
			return
		end

		if currentBtnTween then
			currentBtnTween:Cancel()
		end

		currentBtnTween = TweenService:Create(
			btn,
			tweenInfoClick,
			{
				Size = clickSize,
				Position = UDim2.new(
					0.5,
					-clickSize.X.Offset / 2,
					btn.Position.Y.Scale,
					btn.Position.Y.Offset
				)
			}
		)

		currentBtnTween:Play()
	end)

	btn.MouseButton1Up:Connect(function()

		if isAnimating then
			return
		end

		if btn.BackgroundTransparency > 0.5 then
			return
		end

		if currentBtnTween then
			currentBtnTween:Cancel()
		end

		currentBtnTween = TweenService:Create(
			btn,
			tweenInfoHover,
			{
				Size = hoverSize,
				Position = UDim2.new(
					0.5,
					-hoverSize.X.Offset / 2,
					btn.Position.Y.Scale,
					btn.Position.Y.Offset
				)
			}
		)

		currentBtnTween:Play()
	end)

	return glow
end

--// =========================================================
--// CREATE BUTTON
--// =========================================================

local function createButton(name, posY, height, color)

	local btn = Instance.new("TextButton")

	btn.Name = name
	btn.Parent = MainFrame
	btn.BackgroundColor3 = color
	btn.BorderSizePixel = 0
	btn.ZIndex = 2

	btn:SetAttribute("BaseColor", color)

	local originalSize = UDim2.new(0, 184, 0, height)
	local hoverSize = UDim2.new(0, 194, 0, height + 4)
	local clickSize = UDim2.new(0, 176, 0, height - 3)

	btn.Position = UDim2.new(
		0.5,
		-originalSize.X.Offset / 2,
		0,
		posY
	)

	btn.Size = originalSize

	btn.Font = Enum.Font.GothamBold
	btn.Text = name
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 12

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn

	applyButtonEffects(
		btn,
		color,
		originalSize,
		hoverSize,
		clickSize
	)

	return btn
end

--// =========================================================
--// SLIDER
--// =========================================================

local function createSlider(
	posY,
	labelText,
	minVal,
	maxVal,
	defaultVal,
	callback
)

	local frame = Instance.new("Frame")

	frame.Parent = MainFrame
	frame.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
	frame.BorderSizePixel = 0
	frame.Position = UDim2.new(0.5, -92, 0, posY)
	frame.Size = UDim2.new(0, 184, 0, 38)
	frame.ZIndex = 2

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local label = Instance.new("TextLabel")

	label.Parent = frame
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0, 10, 0, 3)
	label.Size = UDim2.new(1, -20, 0, 14)
	label.Font = Enum.Font.Gotham
	label.Text = labelText .. ": " .. tostring(defaultVal)
	label.TextColor3 = Color3.fromRGB(180, 180, 200)
	label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 3

	local track = Instance.new("Frame")

	track.Parent = frame
	track.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
	track.BorderSizePixel = 0
	track.Position = UDim2.new(0, 10, 0, 23)
	track.Size = UDim2.new(1, -20, 0, 5)
	track.ZIndex = 3

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track

	local defaultPercent =
		(defaultVal - minVal) /
		(maxVal - minVal)

	local fill = Instance.new("Frame")

	fill.Parent = track
	fill.BackgroundColor3 = Color3.fromRGB(80, 130, 255)
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new(defaultPercent, 0, 1, 0)
	fill.ZIndex = 3

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local sliderBtn = Instance.new("TextButton")

	sliderBtn.Parent = track
	sliderBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	sliderBtn.BorderSizePixel = 0
	sliderBtn.AnchorPoint = Vector2.new(0.5, 0.5)
	sliderBtn.Position = UDim2.new(defaultPercent, 0, 0.5, 0)
	sliderBtn.Size = UDim2.new(0, 10, 0, 10)
	sliderBtn.Text = ""
	sliderBtn.ZIndex = 4

	local sliderCorner = Instance.new("UICorner")
	sliderCorner.CornerRadius = UDim.new(1, 0)
	sliderCorner.Parent = sliderBtn

	local dragging = false

	sliderBtn.MouseButton1Down:Connect(function()
		dragging = true
	end)

	UserInputService.InputEnded:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)

		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then

			return
		end

		local mousePos = input.Position.X
		local trackPos = track.AbsolutePosition.X
		local trackSize = track.AbsoluteSize.X

		local relativeX = math.clamp(
			(mousePos - trackPos) / trackSize,
			0,
			1
		)

		fill.Size = UDim2.new(
			relativeX,
			0,
			1,
			0
		)

		sliderBtn.Position = UDim2.new(
			relativeX,
			0,
			0.5,
			0
		)

		local currentVal =
			minVal +
			(maxVal - minVal) *
			relativeX

		currentVal =
			math.floor(currentVal * 10 + 0.5) / 10

		label.Text =
			labelText ..
			": " ..
			tostring(currentVal)

		callback(currentVal)
	end)

	return frame
end

