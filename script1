local function disableFly()
    flying = false

    flyToggle.Text = "FLY: OFF"
    flyToggle.TextColor3 = Color3.fromRGB(220, 220, 230)
    flyToggle.BackgroundColor3 = Color3.fromRGB(35, 35, 45)

    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end

    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end

    if humanoid then
        humanoid.PlatformStand = false
    end
end

local function enableFly()
    if not flyMenuOpen then
        return
    end

    if not rootPart or not rootPart.Parent or not humanoid then
        return
    end

    flying = true

    flyToggle.Text = "FLY: ON"
    flyToggle.TextColor3 = Color3.fromRGB(100, 255, 140)
    flyToggle.BackgroundColor3 = Color3.fromRGB(30, 55, 38)

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.Name = "FlyBodyGyro"
    bodyGyro.P = 90000
    bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "FlyBodyVelocity"
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVelocity.Parent = rootPart

    humanoid.PlatformStand = true
end

local function toggleFly()
    if not flyMenuOpen then
        return
    end

    click()

    if flying then
        disableFly()
    else
        enableFly()
    end
end

--=========================================================
-- FLY MENU OPEN / CLOSE ANIMATION
--=========================================================

local flyOpenPosition = UDim2.new(0.5, 0, 0.50, 0)
local flyClosedPosition = UDim2.new(0.5, 0, 0.56, 0)

local flyScale = Instance.new("UIScale")
flyScale.Name = "FlyMenuScale"
flyScale.Scale = 0.86
flyScale.Parent = flyFrame

local flyOpenInfo = TweenInfo.new(
    0.38,
    Enum.EasingStyle.Back,
    Enum.EasingDirection.Out
)

local flyCloseInfo = TweenInfo.new(
    0.24,
    Enum.EasingStyle.Quint,
    Enum.EasingDirection.In
)

local function prepareFlyAnimation(opening)
    local textTransparency = opening and 0 or 1
    local strokeTransparency = opening and 0.25 or 1

    TweenService:Create(
        flyFrame,
        opening and flyOpenInfo or flyCloseInfo,
        {
            BackgroundTransparency = opening and 0 or 1,
            Position = opening and flyOpenPosition or flyClosedPosition
        }
    ):Play()

    TweenService:Create(
        flyScale,
        opening and flyOpenInfo or flyCloseInfo,
        {
            Scale = opening and 1 or 0.86
        }
    ):Play()

    TweenService:Create(
        flyStroke,
        opening and flyOpenInfo or flyCloseInfo,
        {
            Transparency = strokeTransparency
        }
    ):Play()

    for _, obj in ipairs(flyFrame:GetDescendants()) do
        if obj:IsA("TextLabel")
            or obj:IsA("TextButton")
            or obj:IsA("TextBox") then

            TweenService:Create(
                obj,
                opening and flyOpenInfo or flyCloseInfo,
                {
                    TextTransparency = textTransparency
                }
            ):Play()

        elseif obj:IsA("UIStroke") then

            TweenService:Create(
                obj,
                opening and flyOpenInfo or flyCloseInfo,
                {
                    Transparency = opening and 0.35 or 1
                }
            ):Play()
        end
    end
end

--=========================================================
-- FLY MENU OPEN / CLOSE
