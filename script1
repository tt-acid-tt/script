--=========================================================
-- MAIN HUB SCROLL
--
-- Existing objects are NOT moved to another parent.
-- Only their visual Y position is shifted.
-- Title / X / minimize remain fixed.
--=========================================================

local scrollOffset = 0
local maxScroll = 0

local originalPositions = {}

local function isFixedObject(obj)
    if obj.Name == "Title" then
        return true
    end

    if obj.Parent and obj.Parent.Name == "Title" then
        return true
    end

    return false
end

local function rememberPositions()
    for _, obj in ipairs(MainFrame:GetChildren()) do
        if obj:IsA("GuiObject") and not isFixedObject(obj) then
            if not originalPositions[obj] then
                originalPositions[obj] = obj.Position
            end
        end
    end
end

rememberPositions()

local function applyScroll()
    rememberPositions()

    for obj, pos in pairs(originalPositions) do
        if obj and obj.Parent == MainFrame and obj:IsA("GuiObject") then
            obj.Position = UDim2.new(
                pos.X.Scale,
                pos.X.Offset,
                pos.Y.Scale,
                pos.Y.Offset - scrollOffset
            )
        end
    end
end

local function setScroll(value)
    scrollOffset = math.clamp(value, 0, maxScroll)
    applyScroll()
end

-- Current original HUB content reaches roughly Y=476.
-- This gives a small scroll area while keeping the original
-- close/minimize/title untouched.
maxScroll = 120

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        if flyMenuOpen then
            -- scrolling still works; Fly GUI is independent
        end

        setScroll(scrollOffset - input.Position.Z * 45)
    end
end)

