--============================================================
-- RESTORE MAIN GUI
--============================================================

local function restoreMainGUI()

	if not minimized then
		return
	end

	minimized = false

	MinimizeBtn.Text = "-"

	DynamicIsland.Visible = false

	Title.Visible = true

	TweenService:Create(
		MainCorner,
		TweenInfo.new(
			0.32,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		{
			CornerRadius =
				UDim.new(
					0,
					16
				)
		}
	):Play()

	TweenService:Create(
		MainFrame,
		TweenInfo.new(
			0.38,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.new(
				0,
				currentWidth,
				0,
				currentHeight
			),

			Position = savedNormalPosition
		}
	):Play()

	task.delay(0.18, function()

		if not minimized then

			MainCorner.CornerRadius =
				UDim.new(
					0,
					16
				)

			Title.Size =
				UDim2.new(
					1,
					0,
					0,
					46
				)

			Sidebar.Visible = true
			Content.Visible = true
			ResizeHandle.Visible = true

			Title.Visible = true
		end
	end)
end

DynamicIsland.MouseButton1Click:Connect(function()

