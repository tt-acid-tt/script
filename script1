--// GLOVE HITBOX
--// =========================================================

local originalPartData = {}

local function restoreHitboxes()

	for part, data in pairs(originalPartData) do

		if part and part.Parent then

			part.Size =
				data.Size

			part.Transparency =
				data.Transparency

			part.CanCollide =
				data.CanCollide

			part.Massless =
				data.Massless
		end
	end

	originalPartData = {}
end

HitboxToggle.MouseButton1Click:Connect(function()

	hitboxActive = not hitboxActive

	if hitboxActive then

		setButtonState(
			HitboxToggle,
			"Glove Hitbox: ON",
			Color3.fromRGB(45, 180, 45)
		)

		originalPartData = {}

		if hitboxConnection then
			hitboxConnection:Disconnect()
		end

		hitboxConnection =
			RunService.RenderStepped:Connect(
				function()

					local character =
						player.Character

					if not character then
						return
					end

					for _, part in ipairs(
						character:GetDescendants()
					) do

						if part:IsA("BasePart")
							and (
								part.Name == "Handle"
								or part.Name == "Glove"
								or part.Name == "RightHand"
							) then

							if not originalPartData[part] then

								originalPartData[part] = {

									Size = part.Size,

									Transparency =
										part.Transparency,

									CanCollide =
										part.CanCollide,

									Massless =
										part.Massless
								}
							end

							local divisor =
								math.max(
									1,
									glovesCount
								)

							part.Size =
								Vector3.new(
									hitboxSizeX / divisor,
									hitboxSizeY / divisor,
									hitboxSizeZ / divisor
								)

							part.Transparency =
								hitboxTransparency

							part.CanCollide = false
							part.Massless = true
						end
					end
				end
			)

	else

		setButtonState(
			HitboxToggle,
			"Glove Hitbox: OFF",
			Color3.fromRGB(200, 50, 50)
		)

		if hitboxConnection then
			hitboxConnection:Disconnect()
			hitboxConnection = nil
		end

		restoreHitboxes()
	end
end)

